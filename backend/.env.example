# Copy to .env for local development. In production set these in your host's dashboard.
ENVIRONMENT=development

# --- SQL Server (ODBC Driver 18 must be installed on the machine) ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=PeptidesNepal
DB_USER=peptides_api
DB_PASSWORD=change-me
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
# Only for a local dev server with a self-signed certificate:
DB_TRUST_SERVER_CERTIFICATE=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Sign-in ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Addresses ---
# Exact origin(s) of the Next.js site, comma-separated. No trailing slash, no "*".
CORS_ORIGINS=http://localhost:3000
# The site's public address: used in emails and payment return links.
FRONTEND_URL=http://localhost:3000
# This API's public address: used in links to uploaded files.
PUBLIC_API_URL=http://localhost:8000

# --- Shipping & handling in NPR (0 = free) ---
# Kathmandu. Default 7500.
DELIVERY_FEE_INSIDE_VALLEY=7500
# Outside Kathmandu is off. Set to true (and a fee) to start delivering there.
DELIVERY_OUTSIDE_VALLEY_ENABLED=false
DELIVERY_FEE_OUTSIDE_VALLEY=0
# Orders at or above this ship free. 0 = no free-delivery offer.
FREE_DELIVERY_THRESHOLD=0

# --- Email (leave SMTP_HOST empty to switch email off) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (port 587), ssl (port 465), or none (local test servers only)
SMTP_SECURITY=starttls
MAIL_FROM="Peptides Nepal <orders@yourdomain.com>"
# New-order and contact-form alerts go here.
SHOP_NOTIFY_EMAIL=

# --- Online payments ---
# test = eSewa/Khalti sandboxes, no real money. live = real payments.
PAYMENTS_ENV=test
# eSewa: empty in test mode uses eSewa's public sandbox merchant (EPAYTEST).
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# Khalti: empty = Khalti online payment off (orders fall back to manual payment).
KHALTI_SECRET_KEY=

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
# Use Redis when running more than one worker: redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=memory://
