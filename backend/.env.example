# Copy to .env for local development. In production set these in your host's dashboard.
ENVIRONMENT=development

# SQL Server connection (ODBC Driver 18 must be installed on the machine)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=PeptidesNepal
DB_USER=peptides_api
DB_PASSWORD=change-me
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
# Only for a local dev server with a self-signed certificate:
DB_TRUST_SERVER_CERTIFICATE=true

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Exact origin(s) of the Next.js site, comma-separated. No trailing slash, no "*".
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_ENABLED=true
# Use Redis when running more than one worker: redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=memory://
