# Public URL of the FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this site (used for canonical links and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number, digits with country code. Defaults to the shop's number (9779745947888) if empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=9779745947888

# Shown in the footer and on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=
