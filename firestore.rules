rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check and connection test
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Products catalog: publicly readable, manageable for inventory sync
    match /products/{productId} {
      allow read: if true;
      allow write: if request.resource.data.name is string && request.resource.data.priceInr is number;
      allow delete: if false;
    }

    // Orders collection: customers can create orders, synchronized across devices
    match /orders/{orderId} {
      allow create: if request.resource.data.customerName is string &&
                       request.resource.data.phone is string &&
                       request.resource.data.totalNpr is number;
      allow read: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Contact and sourcing messages
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.message is string;
      allow read: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}
