{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/guides/", "destination": "/guides/index.html" },
    { "source": "/guides/:slug", "destination": "/guides/:slug/index.html" },
    { "source": "/guides/:slug/", "destination": "/guides/:slug/index.html" },
    { "source": "/posts", "destination": "/posts/index.html" },
    { "source": "/posts/", "destination": "/posts/index.html" },
    { "source": "/posts/:slug", "destination": "/posts/:slug/index.html" },
    { "source": "/posts/:slug/", "destination": "/posts/:slug/index.html" },
    { "source": "/myth-or-fact", "destination": "/myth-or-fact/index.html" },
    { "source": "/myth-or-fact/", "destination": "/myth-or-fact/index.html" },
    { "source": "/products/:slug", "destination": "/products/:slug/index.html" },
    { "source": "/products/:slug/", "destination": "/products/:slug/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/about/", "destination": "/about/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/privacy/", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/terms/", "destination": "/terms/index.html" },
    { "source": "/auth/tiktok/callback", "destination": "/auth/tiktok/callback/index.html" },
    { "source": "/auth/tiktok/callback/", "destination": "/auth/tiktok/callback/index.html" },
    {
      "source": "/((?!assets/|fonts/|qr/|data/|guides/|posts/|products/|myth-or-fact/|about/|privacy/|terms/|auth/|favicon\\.svg|og-image\\.png|googlebe5c6877a9634ad2\\.html|ac2bc0a7d86395eca9eff18b691bd343\\.txt|tiktokwzNKFVmpXKYaVea8PxUsOmoVIXUcaa0G\\.txt|robots\\.txt|sitemap\\.xml|llms\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    { "source": "/products/denik-somatropin-hgh-100iu-kit", "destination": "/products/denik-pharma-ototropin-100iu/", "permanent": true },
    { "source": "/products/denik-somatropin-hgh-100iu-kit/", "destination": "/products/denik-pharma-ototropin-100iu/", "permanent": true },
    { "source": "/products/denik-bpc-157-lyophilized-vial", "destination": "/products/denik-bpc/", "permanent": true },
    { "source": "/products/denik-bpc-157-lyophilized-vial/", "destination": "/products/denik-bpc/", "permanent": true },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "peptides-nepal.vercel.app"
        }
      ],
      "destination": "https://peptides.anup-katuwal.com.np/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline'; object-src 'none'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; base-uri 'self'; frame-ancestors 'none';"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/auth/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
